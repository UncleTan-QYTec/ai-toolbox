{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "ppt-generator/$1"
    }
  ],
  "env": {
    "SKYWORK_SKILL_DIR": "/var/task/skywork-ppt-1.0.3"
  },
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  }
}
